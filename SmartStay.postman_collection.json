    {
      "name": "6. Bookings v2 (Saga)",
      "item": [
        {
          "name": "Saga success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v2/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v2", "bookings"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"USER001\",\n  \"hotelId\": \"{{hotelId}}\",\n  \"roomId\": \"{{roomId}}\",\n  \"checkIn\": \"2026-11-10\",\n  \"checkOut\": \"2026-11-12\",\n  \"guests\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"Booking CONFIRMED\", () => pm.expect(b.data.status).to.eql(\"CONFIRMED\"));",
