        {
          "name": "Booking while Payment Service is down (send 3 times)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v2/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v2", "bookings"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"USER001\",\n  \"hotelId\": \"{{hotelId}}\",\n  \"roomId\": \"{{roomId2}}\",\n  \"checkIn\": \"2026-11-10\",\n  \"checkOut\": \"2026-11-12\",\n  \"guests\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Stop payment-service, then send this three times. The first three return 503 after a rollback; the fourth is rejected immediately because the circuit is OPEN. Restart payment-service, wait 15 seconds and send again to see HALF_OPEN then CLOSED."
          }
        }
      ]
